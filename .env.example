# 서버 전용 설정. VITE_ 접두사를 붙이지 마세요.
# AI_PROVIDER=openai | deepseek | openai-compatible
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
# 기존 OPENAI_API_KEY도 OpenAI 제공자에서 사용할 수 있습니다.
OPENAI_API_KEY=

# DeepSeek으로 쓸 때:
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-flash
# AI_API_KEY=sk-...
# 주소는 기본 https://api.deepseek.com/v1이고, 추론 모드는 코드에서 끕니다.

# OpenAI 호환 Chat Completions + Structured Outputs 제공자로 바꿀 때:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=제공자의-모델명
# AI_API_KEY=제공자의-키
AI_BASE_URL=
